      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "runPHP",
      "code": "<?php require_once '/wordpress/wp-load.php'; GII_Store::update_settings( array( 'demo' => true ) ); GII_Seed::reset( 0 ); flush_rewrite_rules();"
    }
  ]
